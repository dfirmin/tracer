{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lineage manifest \u2014 the conductor's discovery of how one target is built",
  "type": "object",
  "required": [
    "target",
    "build_sites",
    "statements",
    "columns",
    "object_index",
    "enumeration_complete"
  ],
  "properties": {
    "target": {
      "type": "object",
      "required": [
        "schema",
        "name",
        "kind"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "view",
            "materialized_view",
            "unknown"
          ]
        }
      }
    },
    "build_sites": {
      "description": "Every place in the repo that writes the target, in execution order where known.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "evidence"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "e.g. final INSERT/MERGE, CREATE VIEW, saveAsTable, orchestration step"
          },
          "shape": {
            "type": "string",
            "description": "e.g. Teradata BTEQ, Databricks SQL notebook, PySpark spark.sql, Jinja-templated SQL"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "statements": {
      "description": "Every statement that writes the target or an intermediate object its columns are assigned from, with its exact span. The harness copies each span verbatim (original line numbers) into excerpts/ for tracers, so the span must cover the whole statement: target list, SELECT list, FROM/JOIN, WHERE/QUALIFY/GROUP BY.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "start_line",
          "end_line",
          "quote",
          "writes",
          "write_kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "description": "short stable id, e.g. s1_stage_vt_sales; used as a file name"
          },
          "path": {
            "type": "string",
            "description": "repo-relative, starts with repo/"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "description": "verbatim text within the span, e.g. the statement's first line \u2014 the harness checks it"
          },
          "writes": {
            "type": "string",
            "description": "the object this statement writes, as written (templated names as the template)"
          },
          "write_kind": {
            "type": "string",
            "enum": [
              "create_table_as",
              "insert",
              "update",
              "merge",
              "delete_insert",
              "create_view",
              "create_temp",
              "save_as_table",
              "dataframe",
              "other"
            ]
          },
          "role": {
            "type": "string",
            "description": "e.g. full load, incremental path, backfill, staging"
          },
          "execution_order": {
            "type": "integer",
            "description": "position in the run order when known (1 = first)"
          },
          "context": {
            "type": "string",
            "description": "job / environment / condition under which this statement runs, when not every run"
          }
        }
      }
    },
    "columns": {
      "description": "Every column of the target, in the target's own order. Exhaustive.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "ordinal",
          "evidence",
          "assignments"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer"
          },
          "expression": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "description": "where this column's output expression is written"
          },
          "assignments": {
            "description": "Every statement that assigns this column, in execution order: one for a single full load; several when an INSERT is followed by an UPDATE/MERGE, or full and incremental paths both write it. Never collapse to one when more apply.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "statement_id",
                "evidence"
              ],
              "properties": {
                "statement_id": {
                  "type": "string",
                  "description": "a statements[].id"
                },
                "expression": {
                  "type": "string",
                  "description": "the assigned expression as written, if short"
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/evidence"
                  },
                  "description": "the assignment within that statement's span"
                }
              }
            }
          }
        }
      }
    },
    "object_index": {
      "description": "Intermediate objects (temp/volatile tables, CTEs, views, DataFrames) the build reads or creates, with where each is defined. A head start for tracers.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "temp",
              "volatile",
              "cte",
              "view",
              "dataframe",
              "physical",
              "external",
              "file",
              "config"
            ]
          },
          "scope": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "templating": {
      "description": "How names are resolved when they are not literal: config files, env vars, Jinja/f-string params, and the values you resolved.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "placeholder": {
            "type": "string"
          },
          "resolved_to": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Anything a tracer should know before starting: gotchas, ordering, dead ends already hit."
    },
    "enumeration_complete": {
      "type": "boolean",
      "description": "true only when every column of the target is listed; false stops nothing but is reported"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "start_line",
        "end_line",
        "quote"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "description": "verbatim text within those lines \u2014 the harness checks it"
        }
      }
    }
  }
}
