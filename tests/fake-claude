#!/usr/bin/env python3
"""A stand-in for the claude CLI. Reads --agent and the prompt, returns a canned structured_output
from $FAKE_RESPONSES/<agent>[-<column>].json wrapped in a headless JSON envelope. Logs every call
to $FAKE_LOG so tests can assert on flags. FAKE_FAIL_ONCE=<agent-column> makes the first call for
that key return a broken answer, to exercise retry-with-feedback."""
import json, os, re, sys
from pathlib import Path

argv = sys.argv[1:]
prompt = argv[argv.index("-p") + 1]
agent = argv[argv.index("--agent") + 1]
m = re.search(r"^Column: (.+)$", prompt, re.M)
key = agent + ("-" + m.group(1).strip() if m else "")
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps({"key": key, "argv": argv, "prompt": prompt}) + "\n")
resp = Path(os.environ["FAKE_RESPONSES"]) / f"{key}.json"
data = json.loads(resp.read_text())
marker = Path(os.environ["FAKE_LOG"] + f".failed-{key}")
if os.environ.get("FAKE_FAIL_ONCE") == key and not marker.exists():
    marker.touch()
    data = json.loads(json.dumps(data))
    # corrupt the first citation so the entailment check fires
    (data.get("nodes") or data.get("build_sites") or [data])[0]["evidence"][0]["quote"] = "THIS TEXT IS NOT IN THE FILE"
print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "total_cost_usd": float(os.environ.get("FAKE_COST", "0.05")),
                  "num_turns": 3, "session_id": "fake", "result": "", "structured_output": data}))
