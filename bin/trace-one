#!/usr/bin/env bash
# trace-one <column> — one headless column-tracer session; validated, budgeted, resumable.
set -uo pipefail
source "$LINEAGE_HOME/bin/lib/session.sh"
COL="$1"; SAFE=$(echo "$COL" | tr -c 'A-Za-z0-9_\n' '_')
OUT="$RUN_DIR/findings/$SAFE.json"
[[ -s "$OUT" ]] && { echo "  skip $COL (exists)"; exit 0; }

PROMPT="Target: $TARGET
Column: $COL
Manifest: $RUN_DIR/manifest.json
Trace this column to its terminal sources and return the finding."
if run_session "trace-$SAFE" column-tracer "$LINEAGE_TRACER_MODEL" "$LINEAGE_HOME/schemas/finding.schema.json" finding "$COL" "$PROMPT" "$OUT"; then
  echo "  ok   $COL ($(jq '.mappings | length' "$OUT") source(s), confidence $(jq -r .confidence "$OUT"))"
else
  rc=$?
  [[ $rc -eq 3 ]] && { echo "  STOP $COL: run budget exhausted" >&2; exit 0; }
  reason=$(sed 's/^/harness: /' "$RUN_DIR/logs/trace-$SAFE.problems" 2>/dev/null | head -5 | jq -R . | jq -s .)
  jq -n --arg c "$COL" --argjson why "${reason:-[\"tracer session failed\"]}" \
    '{target_column:$c, root_id:"", nodes:[], edges:[], mappings:[], confidence:"low", unresolved:$why, failed:true}' > "$OUT"
  echo "  FAIL $COL (see $RUN_DIR/logs/trace-$SAFE.*)" >&2
fi
exit 0
