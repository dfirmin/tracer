#!/usr/bin/env bash
# tracer — produce a source-to-target mapping CSV for one table/view by reading the ETL repo.
#
#   tracer <schema.table> [--repo <git-url>] [--ref <sha|branch>] [--run <name>]
#          [--notes <file>] [--context <file>] [--columns <file>]
#
#   --notes    navigation hints for this repo (where loaders/config live). Defaults to LINEAGE.md at the
#              repo root when present. Hints and declared assumptions only — never evidence.
#   --context  the execution context to trace under: job, environment, config selection, scope.
#   --columns  JSON array of expected target column names, used only to cross-check enumeration.
#   All three are copied into <run>/inputs/ and hashed into the run identity; omit them on resume
#   to reuse what the run was started with.
#
# If --repo is omitted, $WORK/repo must already be mounted (docker -v /path/to/repo:/work/repo:ro).
# Artifacts land in $WORK/.lineage/<run>/:
#   manifest.json        conductor's discovery (validated: every citation is real)
#   run.json             what this run is valid for (target, sha, harness version …); resume refuses a mismatch
#   findings/<col>.json  one validated tracer graph per column (resumable: these are skipped)
#   findings/<col>.failed.json  why the last attempt failed; retried on resume, never a result
#   reviews/<col>.json   independent review bound to the finding version it saw (finding_hash)
#   lineage.csv          the deliverable (lineage.partial.csv when any column has a gap)
#   dependencies.csv     join/filter/group/window/order/control inputs, deduplicated per target table
#   gaps.md, report.json, budget.json, logs/
#   attempts.jsonl, timeline.jsonl, metrics.json   per-call and per-stage telemetry (bin/metrics)
set -euo pipefail

TARGET="${1:?usage: tracer <schema.table> [--repo url] [--ref ref] [--run name] [--notes f] [--context f] [--columns f]}"; shift
REPO_URL=""; REF=""; RUN=""; NOTES=""; CONTEXT=""; COLUMNS=""
abspath() { [[ -f "$1" ]] || { echo "$2: no such file: $1" >&2; exit 2; }; realpath "$1"; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO_URL="$2"; shift 2;;
    --ref)  REF="$2"; shift 2;;
    --run)  RUN="$2"; shift 2;;
    --notes)   NOTES=$(abspath "$2" --notes); shift 2;;
    --context) CONTEXT=$(abspath "$2" --context); shift 2;;
    --columns) COLUMNS=$(abspath "$2" --columns); shift 2;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

export WORK="${WORK:-/work}" LINEAGE_HOME="${LINEAGE_HOME:-/opt/lineage}"
export LINEAGE_FANOUT="${LINEAGE_FANOUT:-process}" LINEAGE_CONCURRENCY="${LINEAGE_CONCURRENCY:-8}"
export LINEAGE_CONDUCTOR_MODEL="${LINEAGE_CONDUCTOR_MODEL:-opus}" LINEAGE_TRACER_MODEL="${LINEAGE_TRACER_MODEL:-sonnet}"
export LINEAGE_REVIEWER_MODEL="${LINEAGE_REVIEWER_MODEL:-$LINEAGE_TRACER_MODEL}" LINEAGE_REVIEW="${LINEAGE_REVIEW:-low}"
export LINEAGE_MAX_TURNS="${LINEAGE_MAX_TURNS:-60}" LINEAGE_ATTEMPTS="${LINEAGE_ATTEMPTS:-2}" LINEAGE_TIMEOUT="${LINEAGE_TIMEOUT:-900}"
export LINEAGE_CALL_BUDGET="${LINEAGE_CALL_BUDGET:-2}" LINEAGE_RUN_BUDGET="${LINEAGE_RUN_BUDGET:-100}"
SCHEMAS="$LINEAGE_HOME/schemas"
cd "$WORK"
source "$LINEAGE_HOME/bin/lib/session.sh"

# ---- 0. workspace ---------------------------------------------------------------------------
if [[ -n "$REPO_URL" ]]; then
  rm -rf repo && git clone --quiet ${REF:+--branch "$REF"} --depth 1 "$REPO_URL" repo
fi
[[ -n "$(ls -A repo 2>/dev/null)" ]] || { echo "no repo at $WORK/repo" >&2; exit 2; }
if [[ -n "$(git -C repo status --porcelain 2>/dev/null)" ]]; then
  echo "repo has uncommitted changes; citations would not resolve to the commit — commit or stash first" >&2; exit 2
fi
SHA=$(git -C repo rev-parse HEAD 2>/dev/null || echo "unknown")
REMOTE=$(git -C repo remote get-url origin 2>/dev/null || echo "$REPO_URL")
WEB=$(echo "$REMOTE" | sed -E 's#^git@([^:]+):#https://\1/#; s#\.git$##')
export CODE_URL_BASE="${LINEAGE_CODE_URL_BASE:-$WEB/blob/$SHA}"

RUN="${RUN:-$(echo "$TARGET" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '_')-$(date -u +%Y%m%dT%H%M%SZ)}"
export RUN_DIR=".lineage/$RUN" TARGET
mkdir -p "$RUN_DIR/findings" "$RUN_DIR/reviews" "$RUN_DIR/logs" "$RUN_DIR/inputs"

# ---- run inputs: notes, context, expected columns ---------------------------------------------
# A flag given now must match what a resumed run started with (the identity check refuses it
# otherwise); a flag omitted on resume reuses the recorded file.
RESUMING=false; [[ -f "$RUN_DIR/run.json" ]] && RESUMING=true
stage_input() {  # <source-or-empty> <dest-name>
  local src="$1" dst="$RUN_DIR/inputs/$2"
  if [[ -n "$src" ]]; then
    if $RESUMING && [[ -f "$dst" ]] && ! cmp -s "$src" "$dst"; then cp "$src" "$dst.offered"; return; fi
    $RESUMING && [[ ! -f "$dst" ]] && { cp "$src" "$dst.offered"; return; }
    cp "$src" "$dst"
  fi
}
[[ -z "$NOTES" && -f repo/LINEAGE.md ]] && NOTES="$WORK/repo/LINEAGE.md"
stage_input "$NOTES" notes.md
stage_input "$CONTEXT" context.txt
if [[ -n "$COLUMNS" ]]; then
  jq -e 'type == "array" and length > 0 and all(type == "string")' "$COLUMNS" >/dev/null 2>&1 \
    || { echo "--columns must be a non-empty JSON array of column names" >&2; exit 2; }
  stage_input "$COLUMNS" columns.json
fi
input_hash() {  # hash of the offered file if one conflicts, else of the recorded file, else "none"
  local f="$RUN_DIR/inputs/$1"
  if [[ -f "$f.offered" ]]; then sha256sum < "$f.offered" | cut -c1-16; rm -f "$f.offered"
  elif [[ -f "$f" ]]; then sha256sum < "$f" | cut -c1-16
  else echo none; fi
}
NOTES_HASH=$(input_hash notes.md); CONTEXT_HASH=$(input_hash context.txt); COLUMNS_HASH=$(input_hash columns.json)
export INPUTS_DIR="$RUN_DIR/inputs"

# ---- run identity: what a run's findings are valid for ----------------------------------------
# Resume reuses findings only when every component matches. The harness version covers the
# agents, skills and schemas, so findings from an older prompt/contract are never mixed in.
HARNESS_VERSION=$(cd "$LINEAGE_HOME" && find harness schemas -type f | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-16)
IDENTITY=$(jq -nc --arg t "$TARGET" --arg r "$REMOTE" --arg s "$SHA" --arg c "$CODE_URL_BASE" --arg h "$HARNESS_VERSION" \
  --arg n "$NOTES_HASH" --arg x "$CONTEXT_HASH" --arg k "$COLUMNS_HASH" \
  '{target:$t, repo:$r, sha:$s, code_url_base:$c, harness_version:$h, notes:$n, context:$x, expected_columns:$k}')
RUN_IDENTITY=$(echo -n "$IDENTITY" | sha256sum | cut -c1-16)
if [[ -f "$RUN_DIR/run.json" ]]; then
  if ! jq -e '.identity' "$RUN_DIR/run.json" >/dev/null 2>&1; then
    echo "run $RUN predates run identity tracking; its findings cannot be trusted for resume — use a new --run" >&2; exit 2
  fi
  DIFF=$(jq -r --argjson now "$IDENTITY" '($now | keys_unsorted[]) as $k | select(.identity[$k] != $now[$k]) | "\($k): \(.identity[$k] // "absent") → \($now[$k])"' "$RUN_DIR/run.json")
  if [[ -n "$DIFF" ]]; then
    echo "run $RUN was started for a different input and cannot be resumed — use a new --run. Changed:" >&2
    echo "$DIFF" | sed 's/^/  /' >&2; exit 2
  fi
fi
[[ -f "$RUN_DIR/run.json" ]] || jq -n --arg t "$TARGET" --arg r "$REMOTE" --arg s "$SHA" --arg c "$CODE_URL_BASE" \
  --arg f "$LINEAGE_FANOUT" --arg v "$LINEAGE_REVIEW" --arg i "$RUN_IDENTITY" --argjson id "$IDENTITY" --arg d "$(date -u +%FT%TZ)" \
  '{target:$t, repo:$r, sha:$s, code_url_base:$c, fanout:$f, review:$v, run_identity:$i, identity:$id, started:$d}' > "$RUN_DIR/run.json"
# review policy is per invocation, not part of identity: a resumed run may add reviews.
jq --arg v "$LINEAGE_REVIEW" '.review = $v' "$RUN_DIR/run.json" > "$RUN_DIR/run.json.tmp" && mv "$RUN_DIR/run.json.tmp" "$RUN_DIR/run.json"
echo "run: $RUN_DIR  target: $TARGET  sha: $SHA  identity: $RUN_IDENTITY  fanout: $LINEAGE_FANOUT  review: $LINEAGE_REVIEW"
export LINEAGE_INVOCATION="$(date -u +%Y%m%dT%H%M%SZ)-$$"
stage run start

# ---- 1. discover (conductor) ----------------------------------------------------------------
stage discover start
if [[ ! -s "$RUN_DIR/manifest.json" ]]; then
  echo "[1/4] discover"
  PROMPT="Target: $TARGET
Run directory: $RUN_DIR
Produce the manifest for this target.$(inputs_prompt conductor)"
  if [[ "$LINEAGE_FANOUT" == "subagent" ]]; then
    PROMPT+="
Fan-out mode: subagent. After the manifest is written, dispatch column-tracer for every column and write each result to $RUN_DIR/findings/<column>.json before you finish."
  fi
  LINEAGE_MAX_TURNS=$((LINEAGE_MAX_TURNS * 3)) LINEAGE_CALL_BUDGET=$(python3 -c "print($LINEAGE_CALL_BUDGET*4)") \
    run_session discover conductor "$LINEAGE_CONDUCTOR_MODEL" "$SCHEMAS/manifest.schema.json" manifest "" "$PROMPT" "$RUN_DIR/manifest.json" \
    || { stage discover end; echo "conductor produced no valid manifest; see $RUN_DIR/logs/discover.*" >&2; exit 1; }
fi
stage discover end
N=$(jq '.columns | length' "$RUN_DIR/manifest.json")
echo "manifest: $N columns, enumeration_complete=$(jq -r .enumeration_complete "$RUN_DIR/manifest.json"), build site(s): $(jq -r '[.build_sites[].evidence[0].path] | unique | join(", ")' "$RUN_DIR/manifest.json")"

# ---- 2. trace (one tracer per column) -------------------------------------------------------
stage trace start
if [[ "$LINEAGE_FANOUT" == "process" ]]; then
  echo "[2/4] trace ($LINEAGE_CONCURRENCY parallel)"
  jq -r '.columns[].name' "$RUN_DIR/manifest.json" | xargs -P "$LINEAGE_CONCURRENCY" -I{} "$LINEAGE_HOME/bin/trace-one" "{}"
else
  echo "[2/4] trace: done in-session by conductor"
fi
stage trace end

# ---- 3. review (optional, sampled) ----------------------------------------------------------
stage review start
if [[ "$LINEAGE_REVIEW" != "none" ]]; then
  echo "[3/4] review ($LINEAGE_REVIEW)"
  jq -r '.columns[].name' "$RUN_DIR/manifest.json" | xargs -P "$LINEAGE_CONCURRENCY" -I{} "$LINEAGE_HOME/bin/review-one" "{}"
else
  echo "[3/4] review: skipped"
fi
stage review end

# ---- 4. assemble ----------------------------------------------------------------------------
echo "[4/4] assemble"
stage assemble start
python3 "$LINEAGE_HOME/bin/assemble.py" "$RUN_DIR"
stage assemble end
stage run end
python3 "$LINEAGE_HOME/bin/metrics" "$RUN_DIR" || echo "metrics: failed (run outputs are unaffected)" >&2
echo "spend: \$$("$LINEAGE_HOME/bin/budget" total)  → $RUN_DIR/$(jq -r .mapping_file "$RUN_DIR/report.json")"
jq -e .complete "$RUN_DIR/report.json" >/dev/null || exit 3
