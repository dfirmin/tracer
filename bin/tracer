#!/usr/bin/env bash
# tracer — produce a source-to-target mapping CSV for one table/view by reading the ETL repo.
#
#   tracer <schema.table> [--repo <git-url>] [--ref <sha|branch>] [--run <name>]
#
# If --repo is omitted, /work/repo must already be mounted (docker -v /path/to/repo:/work/repo:ro).
# Artifacts land in /work/.lineage/<run>/ (mount it to keep them):
#   manifest.json       conductor's discovery: build site, ordered column list, object index
#   findings/<col>.json one tracer result per column (resumable: existing files are skipped)
#   lineage.csv         the deliverable
#   gaps.md             columns the tracers could not fully resolve, with reasons
#   logs/               raw claude -p envelopes per stage
set -euo pipefail

TARGET="${1:?usage: tracer <schema.table> [--repo url] [--ref ref] [--run name]}"; shift
REPO_URL=""; REF=""; RUN=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO_URL="$2"; shift 2;;
    --ref)  REF="$2"; shift 2;;
    --run)  RUN="$2"; shift 2;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

BIN=/opt/lineage/bin; SCHEMAS=/opt/lineage/schemas
cd /work

# ---- 0. workspace ---------------------------------------------------------------------------
if [[ -n "$REPO_URL" ]]; then
  rm -rf repo && git clone --quiet ${REF:+--branch "$REF"} --depth 1 "$REPO_URL" repo
fi
[[ -d repo/.git || -n "$(ls -A repo 2>/dev/null)" ]] || { echo "no repo at /work/repo" >&2; exit 2; }

SHA=$(git -C repo rev-parse HEAD 2>/dev/null || echo "unknown")
REMOTE=$(git -C repo remote get-url origin 2>/dev/null || echo "$REPO_URL")
# git@github.com:org/repo.git  →  https://github.com/org/repo
WEB=$(echo "$REMOTE" | sed -E 's#^git@([^:]+):#https://\1/#; s#\.git$##')
CODE_URL_BASE="${LINEAGE_CODE_URL_BASE:-$WEB/blob/$SHA}"

RUN="${RUN:-$(echo "$TARGET" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '_')-$(date -u +%Y%m%dT%H%M%SZ)}"
RUN_DIR=".lineage/$RUN"; mkdir -p "$RUN_DIR/findings" "$RUN_DIR/logs"
cat > "$RUN_DIR/run.json" <<JSON
{"target":"$TARGET","repo":"$REMOTE","sha":"$SHA","code_url_base":"$CODE_URL_BASE","fanout":"$LINEAGE_FANOUT","started":"$(date -u +%FT%TZ)"}
JSON
echo "run: $RUN_DIR  target: $TARGET  sha: $SHA  fanout: $LINEAGE_FANOUT"

# ---- 1. discover (conductor) ----------------------------------------------------------------
if [[ ! -s "$RUN_DIR/manifest.json" ]]; then
  echo "[1/3] discover"
  PROMPT="Target: $TARGET
Run directory: $RUN_DIR
Code URL base: $CODE_URL_BASE
Produce the manifest for this target."
  if [[ "$LINEAGE_FANOUT" == "subagent" ]]; then
    PROMPT+="
Fan-out mode: subagent. After the manifest is written, dispatch column-tracer for every column and write each result to $RUN_DIR/findings/<column>.json before you finish."
  fi
  claude -p "$PROMPT" \
    --agent conductor --model "$LINEAGE_CONDUCTOR_MODEL" \
    --permission-mode dontAsk --max-turns "$((LINEAGE_MAX_TURNS * 3))" \
    --output-format json --json-schema "$(cat "$SCHEMAS/manifest.schema.json")" \
    > "$RUN_DIR/logs/discover.json"
  jq -e '.structured_output' "$RUN_DIR/logs/discover.json" > "$RUN_DIR/manifest.json" \
    || { echo "conductor produced no manifest; see $RUN_DIR/logs/discover.json" >&2; exit 1; }
fi
N=$(jq '.columns | length' "$RUN_DIR/manifest.json")
echo "manifest: $N columns, build site(s): $(jq -r '[.build_sites[].path] | join(", ")' "$RUN_DIR/manifest.json")"

# ---- 2. trace (one tracer per column) -------------------------------------------------------
if [[ "$LINEAGE_FANOUT" == "process" ]]; then
  echo "[2/3] trace ($LINEAGE_CONCURRENCY parallel)"
  export RUN_DIR TARGET CODE_URL_BASE SCHEMAS
  jq -r '.columns[].name' "$RUN_DIR/manifest.json" \
    | xargs -P "$LINEAGE_CONCURRENCY" -I{} "$BIN/trace-one" "{}"
else
  echo "[2/3] trace: done in-session by conductor"
fi

# ---- 3. assemble ----------------------------------------------------------------------------
echo "[3/3] assemble"
python3 "$BIN/assemble.py" "$RUN_DIR"
echo "done → $RUN_DIR/lineage.csv"
