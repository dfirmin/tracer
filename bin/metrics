#!/usr/bin/env python3
"""metrics <run_dir> — summarise a run's telemetry into metrics.json and a short table.

Reads attempts.jsonl (one line per claude call, written by bin/lib/session.sh), timeline.jsonl
(stage start/end per invocation, written by bin/tracer) and report.json. Never reads ETL source.
A resumed run is several invocations; wall clock sums each invocation's stage spans, so a
resume that skips work adds little.

Stages by session label: discover | trace-<col> | review-<col>, rereview-<col> | repair-<col>.
Retry classes: transient (gateway/API failure, retried after backoff), structural (missing or
rejected answer, retried with check feedback), semantic (a reviewer rejected the finding and a
repair session ran).
"""
import json, statistics, sys
from collections import defaultdict
from pathlib import Path

run = Path(sys.argv[1])


def lines(name):
    p = run / name
    if not p.exists():
        return []
    out = []
    for line in p.read_text().splitlines():
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            pass  # a torn line from a killed process; skip rather than fail the run
    return out


def stage_of(label):
    if label == "discover":
        return "discover"
    head = label.split("-", 1)[0]
    return {"trace": "trace", "review": "review", "rereview": "review", "repair": "repair"}.get(head, head)


def pct(xs, q):
    if not xs:
        return None
    xs = sorted(xs)
    k = max(0, min(len(xs) - 1, round(q / 100 * (len(xs) - 1))))
    return xs[k]


def total(xs):
    xs = [x for x in xs if isinstance(x, (int, float))]
    return round(sum(xs), 4) if xs else None


attempts = lines("attempts.jsonl")
timeline = lines("timeline.jsonl")
report = json.loads((run / "report.json").read_text()) if (run / "report.json").exists() else {}

# ---- wall clock -----------------------------------------------------------------------------
spans = defaultdict(float)
open_at = {}
invocations = set()
for e in timeline:
    key = (e["invocation"], e["stage"])
    invocations.add(e["invocation"])
    if e["event"] == "start":
        open_at[key] = e["at"]
    elif e["event"] == "end" and key in open_at:
        spans[e["stage"]] += e["at"] - open_at.pop(key)
wall = {s: round(v, 3) for s, v in spans.items()}

# ---- per stage ------------------------------------------------------------------------------
by_stage = defaultdict(list)
for a in attempts:
    by_stage[stage_of(a["label"])].append(a)

stages = {}
for s, rows in sorted(by_stage.items()):
    turns = [a["num_turns"] for a in rows if isinstance(a.get("num_turns"), int)]
    stages[s] = {
        "wall_clock_s": wall.get(s),
        "sessions": len({a["label"] for a in rows}),
        "calls": len(rows),
        "turns": {"total": sum(turns) if turns else None, "p50": pct(turns, 50), "p95": pct(turns, 95), "max": max(turns) if turns else None},
        "tokens": {k: total(a.get(k) for a in rows) for k in ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens")},
        "call_seconds": {"total": total(a.get("duration_s") for a in rows), "p50": pct([a["duration_s"] for a in rows], 50),
                         "p95": pct([a["duration_s"] for a in rows], 95)},
        "cost_usd": total(a.get("cost_usd") for a in rows),
        "outcomes": dict(sorted({o: sum(1 for a in rows if a["outcome"] == o) for o in {a["outcome"] for a in rows}}.items())),
    }

retries = {
    "transient": sum(1 for a in attempts if a["outcome"] == "transient_failure"),
    "structural": sum(1 for a in attempts if a["outcome"] in ("no_output", "rejected")),
    "semantic": len({a["label"] for a in attempts if stage_of(a["label"]) == "repair"}),
}
cost = total(a.get("cost_usd") for a in attempts) or 0.0
resolved = sum(1 for c in report.get("columns", []) if c.get("status") == "complete")
all_turns = [a["num_turns"] for a in attempts if isinstance(a.get("num_turns"), int)]

metrics = {
    "run": run.name,
    "run_identity": report.get("run_identity"),
    "invocations": len(invocations),
    "wall_clock_s": {"run": wall.get("run"), **{k: v for k, v in wall.items() if k != "run"}},
    "sessions": len({a["label"] for a in attempts}),
    "calls": len(attempts),
    "turns": {"total": sum(all_turns) if all_turns else None, "p50": pct(all_turns, 50), "p95": pct(all_turns, 95)},
    "tokens": {k: total(a.get(k) for a in attempts) for k in ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens")},
    "retries": retries,
    "rate_limit_hits": sum(a.get("rate_limit_hits") or 0 for a in attempts),
    "cost_usd": round(cost, 4),
    "columns": {"total": report.get("column_count"), "resolved": resolved},
    "cost_per_resolved_column_usd": round(cost / resolved, 4) if resolved else None,
    "complete": report.get("complete"),
    "stages": stages,
}
(run / "metrics.json").write_text(json.dumps(metrics, indent=2) + "\n")


def fmt(x):
    return "-" if x is None else (f"{x:,.1f}" if isinstance(x, float) else f"{x:,}")


print(f"metrics: {metrics['sessions']} sessions / {metrics['calls']} calls, {fmt(metrics['turns']['total'])} turns, "
      f"wall {fmt(metrics['wall_clock_s']['run'])}s, ${metrics['cost_usd']:.2f} "
      f"(${fmt(metrics['cost_per_resolved_column_usd'])}/resolved column), retries t/s/s="
      f"{retries['transient']}/{retries['structural']}/{retries['semantic']}, 429s={metrics['rate_limit_hits']}")
for s, m in stages.items():
    print(f"  {s:<9} wall {fmt(m['wall_clock_s']):>8}s  sessions {m['sessions']:>4}  calls {m['calls']:>4}  "
          f"turns p50/p95 {fmt(m['turns']['p50'])}/{fmt(m['turns']['p95'])}  in/out tok {fmt(m['tokens']['input_tokens'])}/{fmt(m['tokens']['output_tokens'])}")
